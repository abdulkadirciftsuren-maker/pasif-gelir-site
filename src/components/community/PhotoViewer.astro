---
// Tam ekran fotoğraf görüntüleyici: dokununca büyür, ok tuşları ya da parmakla kaydırarak sıradakine geçilir.
// Kullanım: window.fincanlaViewer.open(items, index) — items, /api/galeri'den gelen kayıtlar.
import { type Lang } from '../../i18n/ui';
import { ct } from '../../i18n/community';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = ct(lang);
---

<dialog id="pv" class="pv" aria-label={c.galleryTitle}>
  <button class="pv-close" type="button">✕ {c.close}</button>
  <button class="pv-nav pv-prev" type="button" aria-label={c.prev}>‹</button>
  <figure class="pv-fig">
    <img id="pv-img" alt="" />
    <figcaption>
      <span id="pv-count" class="pv-count"></span>
      <strong id="pv-title" class="pv-title"></strong>
      <span id="pv-by" class="pv-by"></span>
      <span id="pv-text" class="pv-text"></span>
    </figcaption>
  </figure>
  <button class="pv-nav pv-next" type="button" aria-label={c.next}>›</button>
</dialog>

<script define:vars={{ c }}>
  const dialog = document.getElementById('pv');
  const img = document.getElementById('pv-img');
  const prevBtn = dialog.querySelector('.pv-prev');
  const nextBtn = dialog.querySelector('.pv-next');
  let list = [];
  let index = 0;

  function show() {
    const item = list[index];
    img.src = `/foto/${item.id}`;
    img.alt = item.title || item.name;
    document.getElementById('pv-count').textContent = list.length > 1 ? `${index + 1} / ${list.length}` : '';
    document.getElementById('pv-title').textContent = item.title || '';
    document.getElementById('pv-by').textContent = `${c.by}: ${item.name}`;
    document.getElementById('pv-text').textContent = item.text || '';
    prevBtn.hidden = index === 0;
    nextBtn.hidden = index >= list.length - 1;
    dialog.scrollTop = 0;
    // Sıradaki fotoğrafı önceden yükle, geçiş beklemesin
    if (list[index + 1]) new Image().src = `/foto/${list[index + 1].id}`;
  }

  function go(step) {
    const n = index + step;
    if (n < 0 || n >= list.length) return;
    index = n;
    show();
  }

  window.fincanlaViewer = {
    open(items, i) {
      list = items;
      index = i;
      show();
      dialog.showModal();
      // Arkadaki sayfa kaymasın, sadece görüntüleyici kaysın
      document.documentElement.style.overflow = 'hidden';
      // Telefonun "geri" tuşu sayfadan çıkmasın, sadece fotoğrafı kapatsın
      history.pushState({ pv: true }, '');
      pushed = true;
    },
  };
  let pushed = false;
  dialog.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    if (pushed) { pushed = false; history.back(); }
  });
  window.addEventListener('popstate', () => {
    if (dialog.open) { pushed = false; dialog.close(); }
  });

  prevBtn.addEventListener('click', () => go(-1));
  nextBtn.addEventListener('click', () => go(1));
  dialog.querySelector('.pv-close').addEventListener('click', () => dialog.close());
  // Fotoğrafın dışındaki boş alana tıklayınca kapanır
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target.classList.contains('pv-fig')) dialog.close();
  });
  // Belge düzeyinde dinliyoruz: son fotoğrafta "sonraki" düğmesi gizlenince odak dialog'dan çıkabiliyor
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') go(-1);
    if (e.key === 'ArrowRight') go(1);
  });

  // Parmakla sağa/sola kaydırma
  let startX = null;
  let startY = 0;
  dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
  dialog.addEventListener('touchend', (e) => {
    if (startX === null) return;
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    startX = null;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
  });
</script>

<style>
  .pv { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(12, 8, 6, .96); color: #f6ead9; overflow-y: auto; overscroll-behavior: contain; }
  .pv::backdrop { background: rgba(12, 8, 6, .9); }
  /* Uzun notlar için görüntüleyici aşağı kaydırılabilir; Kapat ve oklar ekranda sabit kalır */
  .pv-fig { margin: 0; min-height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .75rem; padding: 4rem 4.5rem 3rem; box-sizing: border-box; }
  /* Fotoğraf hiç kırpılmadan, ekrana sığacak şekilde gösterilir */
  .pv-fig img { max-width: 100%; max-height: min(calc(100dvh - 9rem), 68dvh); width: auto; height: auto; object-fit: contain; border-radius: 10px; }
  .pv-fig figcaption { display: grid; gap: .2rem; text-align: center; max-width: 40rem; line-height: 1.45; }
  .pv-count { font-size: .85rem; opacity: .7; }
  .pv-title { font: 700 1.15rem var(--serif); }
  .pv-title:empty, .pv-text:empty, .pv-count:empty { display: none; }
  .pv-by { opacity: .85; }
  .pv-text { white-space: pre-line; opacity: .9; }
  .pv-nav, .pv-close { position: fixed; z-index: 2; border: 0; background: rgba(255, 255, 255, .16); color: #fff; cursor: pointer; font: inherit; border-radius: 999px; }
  .pv-close { top: .9rem; right: .9rem; padding: .55rem 1.1rem; font-weight: 700; background: rgba(255, 255, 255, .92); color: #2b1a12; box-shadow: 0 4px 16px rgba(0, 0, 0, .4); }
  .pv-nav { top: 50%; transform: translateY(-50%); width: 3rem; height: 3rem; font-size: 2.2rem; line-height: 1; }
  .pv-prev { left: .9rem; }
  .pv-next { right: .9rem; }
  .pv-nav:hover { background: rgba(255, 255, 255, .3); }
  .pv-close:hover { background: #fff; }
  /* Yatay geniş ekranda (dizüstü) yazı fotoğrafın yanında durur, aşağı kaydırmaya gerek kalmaz */
  @media (min-width: 900px) and (orientation: landscape) {
    .pv-fig { flex-direction: row; gap: 2rem; padding: 4rem 5rem 2rem; }
    .pv-fig img { max-width: calc(100% - 24rem); max-height: calc(100dvh - 6rem); }
    .pv-fig figcaption { width: 22rem; flex: none; text-align: left; justify-items: start; max-height: calc(100dvh - 8rem); overflow-y: auto; }
  }
  @media (max-width: 640px) {
    .pv-fig { padding: 4rem .75rem 2.5rem; }
    .pv-nav { width: 2.5rem; height: 2.5rem; font-size: 1.8rem; background: rgba(0, 0, 0, .45); }
    .pv-prev { left: .4rem; }
    .pv-next { right: .4rem; }
  }
</style>
