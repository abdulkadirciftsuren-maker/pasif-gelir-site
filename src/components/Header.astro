---
import { SITE } from '../config';
import { languages, localePath, staticPages, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
// Bu sayfanın diğer dillerdeki karşılığı yoksa o dilin ana sayfasına gider.
const others = (Object.keys(languages) as Lang[])
  .filter((l) => l !== lang)
  .map((l) => ({ lang: l, href: alternates[l] ?? staticPages.home[l] }));
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={localePath(lang)} aria-label={SITE.name}>
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M6 12h17v7a8 8 0 0 1-8 8h-1a8 8 0 0 1-8-8z" fill="currentColor" />
        <path d="M23 14h2.5a3.5 3.5 0 0 1 0 7H23" fill="none" stroke="currentColor" stroke-width="2.4" />
        <path d="M11 4c-1.5 2 1.5 3 0 5M16 4c-1.5 2 1.5 3 0 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Ana menü">
      <a href={localePath(lang) + '#rehberler'}>{t(lang, 'nav.guides')}</a>
      <a href={staticPages.calculator[lang]}>{t(lang, 'nav.tools')}</a>
      <a href={staticPages.about[lang]} class="hide-sm">{t(lang, 'nav.about')}</a>
      {others.map((o) => (
        <a href={o.href} hreflang={o.lang} lang={o.lang} class="lang" title={languages[o.lang]}>{o.lang.toUpperCase()}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header { background: var(--espresso); color: var(--cream); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
  .logo { display: flex; align-items: center; gap: .5rem; color: var(--cream); text-decoration: none; font: 700 1.35rem var(--serif); }
  .logo svg { color: var(--warm); }
  nav { display: flex; align-items: center; gap: 1.1rem; font-size: .95rem; }
  nav a { color: var(--cream); text-decoration: none; white-space: nowrap; opacity: .9; }
  nav a:hover { color: var(--warm); opacity: 1; }
  .lang { border: 1px solid rgba(246, 234, 217, .35); border-radius: 999px; padding: .15rem .6rem; font-size: .8rem; font-weight: 700; }
  @media (max-width: 560px) { .hide-sm { display: none; } nav { gap: .5rem; font-size: .85rem; } .logo { font-size: 1.15rem; } .lang { padding: .1rem .45rem; } }
</style>
