---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { SITE } from '../config';
import { staticPages, t, type Lang } from '../i18n/ui';
import { getPosts, postUrl } from '../lib';
import { communityPages, ct } from '../i18n/community';
import PhotoViewer from './community/PhotoViewer.astro';
import Greeting from './Greeting.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = await getPosts(lang);
const latest = posts.slice(0, 6);
// Son 14 günde yayımlanan yazılara "Yeni" etiketi (site her yayında yeniden derlenir)
const isNew = (d: Date) => Date.now() - d.valueOf() < 14 * 24 * 60 * 60 * 1000;
// Arama kutusu için küçük dizin: başlık, açıklama, kategori adı ve adres
const searchIndex = posts.map((p) => ({
  t: p.data.title,
  d: p.data.description,
  c: t(lang, `cat.${p.data.category}`),
  u: postUrl(p),
}));
const searchTexts = { empty: t(lang, 'search.empty') };
const categories = (['yontem', 'ekipman', 'temel', 'hikaye'] as const)
  .map((cat) => ({ cat, posts: posts.filter((p) => p.data.category === cat) }))
  .filter((c) => c.posts.length > 0);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL(staticPages.home[lang], Astro.site).href,
    inLanguage: lang,
  },
];
---

<BaseLayout lang={lang} title={SITE.name} description={t(lang, 'site.description')} alternates={staticPages.home} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <Greeting lang={lang} />
        <h1>{t(lang, 'home.hero')}</h1>
        <p>{t(lang, 'home.lead')}</p>
        <form class="search" role="search" action="#" onsubmit="return false">
          <label for="q" class="sr-only">{t(lang, 'search.label')}</label>
          <input id="q" type="search" placeholder={t(lang, 'search.placeholder')} autocomplete="off" />
          <ul id="results" hidden></ul>
        </form>
        <p class="hero-actions">
          <a class="btn" href={staticPages.machineQuiz[lang]}>🧭 {t(lang, 'nav.quiz')}</a>
          <a class="btn alt" href={staticPages.calculator[lang]}>{t(lang, 'home.cta')}</a>
        </p>
      </div>
      <img src="/img/kapak/turk-kahvesi.svg" alt="" width="640" height="360" fetchpriority="high" />
    </div>
  </section>

  <!-- Test kutusu: her ekranda görünür, okuru makine seçim testine yönlendirir -->
  <div class="container">
    <a class="quiz-banner" href={staticPages.machineQuiz[lang]}>
      <span class="quiz-icon" aria-hidden="true">🧭</span>
      <span class="quiz-copy">
        <strong>{t(lang, 'home.quizTitle')}</strong>
        <span>{t(lang, 'home.quizText')}</span>
      </span>
      <span class="btn">{t(lang, 'home.quizCta')} →</span>
    </a>
  </div>

  <!-- Geniş ekranda iki sütun: solda son rehberler, sağda okur fotoğrafları ve kısa yollar -->
  <div class="container home-main">
    <section class="section" id="rehberler" aria-labelledby="latest">
      <h2 id="latest">{t(lang, 'home.latest')}</h2>
      <div class="grid">{latest.map((post) => <PostCard post={post} isNew={isNew(post.data.pubDate)} />)}</div>
    </section>

    <aside class="home-side">
      <section class="community" aria-labelledby="community">
        <div>
          <h2 id="community">{t(lang, 'community.homeTitle')}</h2>
          <p>{t(lang, 'community.homeText')}</p>
        </div>
        <div id="home-strip" class="strip" hidden></div>
        <p class="actions">
          <a class="btn" href={communityPages.share[lang]}>📷 {t(lang, 'community.homeCta')}</a>
          <a class="link" href={communityPages.gallery[lang]}>{t(lang, 'community.homeGallery')} →</a>
        </p>
      </section>
      <div class="side-extra">
        <a class="promo quiz" href={staticPages.machineQuiz[lang]}>
          <strong>🧭 {t(lang, 'nav.quiz')}</strong>
          <span>{t(lang, 'home.quizCta')} →</span>
        </a>
        <a class="promo" href={staticPages.calculator[lang]}>
          <strong>{t(lang, 'aside.calcTitle')}</strong>
          <span>{t(lang, 'aside.calcText')}</span>
        </a>
        <nav class="topics" aria-label={t(lang, 'home.topics')}>
          <p>{t(lang, 'home.topics')}</p>
          <ul>
            {categories.map(({ cat, posts }) => (
              <li class={`cat-${cat}`}><a href={`#topic-${cat}`}>{t(lang, `cat.${cat}`)}</a> <span>{posts.length}</span></li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>
  </div>
  <PhotoViewer lang={lang} />

  {categories.map(({ cat, posts }) => (
    <section class={`topic cat-${cat}`} aria-labelledby={`topic-${cat}`}>
      <div class="container">
        <span class="chip">{t(lang, 'home.topics')}</span>
        <h2 id={`topic-${cat}`}>{t(lang, `cat.${cat}`)}</h2>
        <p class="muted">{t(lang, `cat.${cat}.desc`)}</p>
        <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
      </div>
    </section>
  ))}
</BaseLayout>

<script define:vars={{ by: ct(lang).by, seeAll: ct(lang).seeAll, galleryUrl: communityPages.gallery[lang] }}>
  // Ana sayfadaki okur fotoğrafları şeridi: en yeni fotoğraflar yana kayar, dokununca büyür.
  (async () => {
    const strip = document.getElementById('home-strip');
    try {
      const res = await fetch('/api/galeri?sayfa=0');
      if (!res.ok) return;
      const data = await res.json();
      const items = data.items.slice(0, 12);
      if (items.length === 0) return;
      items.forEach((item, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tile';
        const img = document.createElement('img');
        img.src = `/foto/${item.id}`;
        img.alt = item.title || `${by}: ${item.name}`;
        img.loading = 'lazy';
        const cap = document.createElement('span');
        cap.textContent = item.name;
        btn.append(img, cap);
        btn.addEventListener('click', () => window.fincanlaViewer.open(items, i));
        strip.append(btn);
      });
      if (data.more || data.items.length > items.length) {
        const all = document.createElement('a');
        all.className = 'tile all';
        all.href = galleryUrl;
        all.textContent = `${seeAll} →`;
        strip.append(all);
      }
      strip.hidden = false;
    } catch {}
  })();
</script>

<script define:vars={{ searchIndex, searchTexts, lang }}>
  // Türkçe/Almanca harfleri sadeleştirir: "Öğütücü" → "ogutucu", "Mühle" → "muhle"
  const norm = (s) => s.toLocaleLowerCase(lang).replace(/ı/g, 'i').replace(/ß/g, 'ss')
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const items = searchIndex.map((i) => ({ ...i, n: norm(`${i.t} ${i.d} ${i.c}`) }));
  const input = document.getElementById('q');
  const list = document.getElementById('results');
  input.addEventListener('input', () => {
    const words = norm(input.value).split(/\s+/).filter((w) => w.length > 1);
    list.replaceChildren();
    if (!words.length) { list.hidden = true; return; }
    const hits = items
      .map((i) => ({ i, score: words.filter((w) => i.n.includes(w)).length + (words.every((w) => norm(i.t).includes(w)) ? 2 : 0) }))
      .filter((h) => h.score >= words.length)
      .sort((a, b) => b.score - a.score)
      .slice(0, 8);
    if (!hits.length) {
      const li = document.createElement('li');
      li.className = 'empty';
      li.textContent = searchTexts.empty;
      list.append(li);
    }
    for (const { i } of hits) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = i.u;
      const strong = document.createElement('strong');
      strong.textContent = i.t;
      const small = document.createElement('small');
      small.textContent = i.c;
      a.append(strong, small);
      li.append(a);
      list.append(li);
    }
    list.hidden = false;
  });
</script>

<style>
  .hero { padding: 4rem 0; background: linear-gradient(135deg, var(--espresso) 0%, var(--espresso-2) 100%); color: var(--cream); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center; }
  .hero h1 { max-width: 16ch; color: #fff; }
  .hero p { max-width: 34rem; font-size: 1.2rem; opacity: .85; margin: 0 0 1.75rem; }
  .search { position: relative; max-width: 34rem; margin: 0 0 1.25rem; }
  .search input { width: 100%; box-sizing: border-box; padding: .85rem 1.1rem; font-size: 1.05rem; border-radius: 999px; border: 2px solid transparent; background: #fff; color: #2b1a12; }
  .search input:focus { outline: none; border-color: var(--warm); }
  .search ul { position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + .4rem); list-style: none; margin: 0; padding: .35rem; background: #fff; border-radius: 14px; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, .45); max-height: 22rem; overflow-y: auto; }
  .search :global(li a) { display: grid; gap: .1rem; padding: .6rem .8rem; border-radius: 10px; color: #2b1a12; text-decoration: none; }
  .search :global(li a:hover), .search :global(li a:focus) { background: #f6eadb; }
  .search :global(strong) { font-weight: 700; line-height: 1.35; }
  .search :global(small) { color: #7a6a60; }
  .search :global(.empty) { padding: .6rem .8rem; color: #7a6a60; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .hero .btn { background: var(--warm); color: var(--espresso); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin: 0; }
  .hero .btn.alt { background: transparent; color: var(--cream); border: 2px solid rgba(255, 255, 255, .35); }
  .quiz-banner { display: flex; align-items: center; gap: 1.25rem; margin: 2rem 0 .5rem; padding: 1.25rem 1.5rem; border-radius: var(--radius); background: linear-gradient(120deg, #fdf0e3 0%, #f7dcc4 100%); border: 2px solid var(--warm); color: var(--text); text-decoration: none; transition: transform .15s; }
  .quiz-banner:hover { transform: translateY(-2px); }
  .quiz-icon { font-size: 2.6rem; line-height: 1; }
  .quiz-copy { display: grid; gap: .25rem; flex: 1; }
  .quiz-copy strong { font: 700 1.35rem var(--serif); color: var(--espresso); }
  .quiz-copy span { color: #5a4636; }
  .quiz-banner .btn { flex: none; }
  @media (prefers-color-scheme: dark) {
    .quiz-banner { background: linear-gradient(120deg, #3a2a22 0%, #4a3226 100%); }
    .quiz-copy strong { color: #fbe9d7; }
    .quiz-copy span { color: #e2d3c4; }
  }
  @media (max-width: 640px) { .quiz-banner { flex-wrap: wrap; } .quiz-icon { font-size: 2rem; } .quiz-banner .btn { width: 100%; text-align: center; } }
  .hero img { width: 100%; border-radius: 20px; box-shadow: 0 24px 50px -20px rgba(0, 0, 0, .6); }
  .section { padding: 1rem 0 2rem; }
  .community { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; background: var(--accent-soft); border-radius: var(--radius); padding: 1.5rem 1.75rem; }
  .community h2 { margin: 0 0 .4rem; }
  .community p { margin: 0; max-width: 40rem; }
  .community .actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .community .link { font-weight: 600; }
  /* Okur fotoğrafları şeridi: telefonda parmakla yana kaydırılır */
  .strip { flex-basis: 100%; display: flex; gap: .8rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .5rem; -webkit-overflow-scrolling: touch; }
  .strip :global(.tile) { flex: 0 0 8.5rem; scroll-snap-align: start; display: grid; gap: .35rem; padding: 0; border: 0; background: none; cursor: pointer; font: inherit; color: var(--text); text-align: left; text-decoration: none; }
  .strip :global(.tile img) { width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: cover; border-radius: var(--radius); background: var(--surface); transition: transform .2s; }
  .strip :global(.tile:hover img) { transform: scale(1.03); }
  .strip :global(.tile span) { font-size: .85rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .strip :global(.tile.all) { aspect-ratio: 4 / 5; display: grid; place-items: center; text-align: center; border: 2px dashed var(--accent); border-radius: var(--radius); color: var(--accent); font-weight: 700; }
  .side-extra { display: none; }
  /* Geniş ekran: sağda sabit kalan sütun; fotoğraflar iki sütunlu, daha büyük */
  @media (min-width: 1100px) {
    .home-main { display: grid; grid-template-columns: minmax(0, 1fr) 24rem; gap: 2.5rem; align-items: start; padding-top: 1rem; }
    .home-side { display: grid; gap: 1.25rem; margin-top: 3.4rem; }
    .community { display: grid; gap: 1rem; padding: 1.5rem; }
    .community .actions { justify-content: space-between; }
    .strip { display: grid; grid-template-columns: 1fr 1fr; overflow: visible; padding: 0; }
    /* En yeni fotoğraf büyük, altında dört küçük */
    .strip :global(.tile:first-child) { grid-column: span 2; }
    /* Büyük fotoğraf kırpılmadan, kendi oranıyla görünür */
    .strip :global(.tile:first-child img) { aspect-ratio: auto; max-height: 30rem; object-fit: contain; background: rgba(0, 0, 0, .06); }
    .strip :global(.tile:nth-child(n+6):not(.all)) { display: none; }
    .side-extra { display: grid; gap: 1.25rem; }
    .promo { display: grid; gap: .3rem; padding: 1.1rem 1.25rem; border-radius: var(--radius); background: var(--espresso); color: var(--cream); text-decoration: none; }
    .promo strong { font: 700 1.1rem var(--serif); color: #fff; }
    .promo span { opacity: .85; font-size: .95rem; }
    .promo:hover { filter: brightness(1.15); }
    .promo.quiz { background: var(--warm); color: var(--espresso); }
    .promo.quiz strong { color: var(--espresso); }
    .topics { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; }
    .topics p { margin: 0 0 .5rem; font-size: .8rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
    .topics ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
    .topics li { display: flex; justify-content: space-between; align-items: center; }
    .topics a { color: var(--cat); font-weight: 600; text-decoration: none; }
    .topics a:hover { text-decoration: underline; }
    .topics span { font-size: .8rem; color: var(--muted); background: var(--cat-soft); border-radius: 999px; padding: 0 .55rem; }
  }
  @media (max-width: 1099px) { .home-side { margin-top: 1rem; } }
  .topic { background: var(--cat-soft); padding: 2.5rem 0 3rem; margin-top: 1.5rem; }
  .topic .chip { background: var(--surface); }
  .topic h2 { margin: .6rem 0 .25rem; color: var(--cat); }
  .topic p { margin: 0 0 1.25rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.25rem; }
  @media (max-width: 760px) { .hero-grid { grid-template-columns: 1fr; } .hero { padding: 3rem 0; } }
</style>
