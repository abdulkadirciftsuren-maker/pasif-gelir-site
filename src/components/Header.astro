---
import { SITE } from '../config';
import Logo from './Logo.astro';
import { languages, localePath, staticPages, t, type Lang } from '../i18n/ui';
import { communityPages } from '../i18n/community';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
// Bu sayfanın diğer dillerdeki karşılığı yoksa o dilin ana sayfasına gider.
const others = (Object.keys(languages) as Lang[])
  .filter((l) => l !== lang)
  .map((l) => ({ lang: l, href: alternates[l] ?? staticPages.home[l] }));
const home = localePath(lang);
const cats = ['yontem', 'ekipman', 'temel'] as const;
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={home} aria-label={SITE.name}>
      <Logo lang={lang} />
    </a>
    <nav aria-label="Ana menü">
      <a href={home + '#rehberler'} class="wide">{t(lang, 'nav.guides')}</a>
      <a href={staticPages.calculator[lang]} class="wide">{t(lang, 'nav.tools')}</a>
      <a href={communityPages.gallery[lang]} class="wide">{t(lang, 'nav.community')}</a>
      {others.map((o) => (
        <a href={o.href} hreflang={o.lang} lang={o.lang} class="lang" title={languages[o.lang]} translate="no">{o.lang.toUpperCase()}</a>
      ))}
      <button id="menu-btn" class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="bars" aria-hidden="true"></span>{t(lang, 'nav.menu')}
      </button>
    </nav>
  </div>

  <!-- Açılır menü: telefonda bütün bağlantılar burada; bilgisayarda konular ve topluluk kısayolları -->
  <div id="site-menu" class="menu" hidden>
    <div class="container menu-grid">
      <div>
        <p class="menu-title">{t(lang, 'home.topics')}</p>
        <a href={home + '#rehberler'}>{t(lang, 'nav.guides')}</a>
        {cats.map((c) => <a class={`cat-${c} cat`} href={`${home}#topic-${c}`}>{t(lang, `cat.${c}`)}</a>)}
      </div>
      <div>
        <p class="menu-title">{t(lang, 'nav.community')}</p>
        <a href={communityPages.gallery[lang]}>{t(lang, 'nav.community')}</a>
        <a href={communityPages.share[lang]}>📷 {t(lang, 'community.homeCta')}</a>
      </div>
      <div>
        <p class="menu-title">Fincanla</p>
        <a href={home}>{t(lang, 'nav.home')}</a>
        <a href={staticPages.calculator[lang]}>{t(lang, 'nav.tools')}</a>
        <a href={staticPages.cafeCalculator[lang]}>☕ {t(lang, 'nav.cafeCalc')}</a>
        <a href={staticPages.about[lang]}>{t(lang, 'nav.about')}</a>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ openLabel: t(lang, 'nav.menu'), closeLabel: t(lang, 'nav.close') }}>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('site-menu');
  function setOpen(open) {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? closeLabel : openLabel);
    btn.classList.toggle('open', open);
  }
  btn.addEventListener('click', () => setOpen(menu.hidden));
  // Menüdeki bir bağlantıya basınca (ör. aynı sayfadaki bir konuya) menü kapansın
  menu.addEventListener('click', (e) => { if (e.target.closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
  document.addEventListener('click', (e) => { if (!menu.hidden && !menu.contains(e.target) && !btn.contains(e.target)) setOpen(false); });
</script>

<style>
  .site-header { position: relative; z-index: 20; background: var(--espresso); color: var(--cream); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.5rem; }
  .logo { display: flex; align-items: center; color: var(--cream); text-decoration: none; }
  nav { display: flex; align-items: center; gap: 1.1rem; font-size: .95rem; }
  nav a { color: var(--cream); text-decoration: none; white-space: nowrap; opacity: .9; }
  nav a:hover { color: var(--warm); opacity: 1; }
  .lang { border: 1px solid rgba(246, 234, 217, .35); border-radius: 999px; padding: .15rem .6rem; font-size: .8rem; font-weight: 700; }
  .menu-btn { display: inline-flex; align-items: center; gap: .5rem; border: 0; border-radius: 999px; padding: .45rem .9rem; background: var(--warm); color: var(--espresso); font: inherit; font-weight: 700; cursor: pointer; }
  .menu-btn:hover { filter: brightness(1.08); }
  /* Üç çizgili simge; menü açılınca X olur */
  .bars, .bars::before, .bars::after { display: block; width: 1rem; height: 2px; background: currentColor; border-radius: 2px; transition: transform .2s, opacity .2s; }
  .bars { position: relative; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -5px; }
  .bars::after { top: 5px; }
  .menu-btn.open .bars { background: transparent; }
  .menu-btn.open .bars::before { transform: translateY(5px) rotate(45deg); }
  .menu-btn.open .bars::after { transform: translateY(-5px) rotate(-45deg); }
  .menu { position: absolute; left: 0; right: 0; top: 100%; background: var(--espresso-2); border-top: 1px solid rgba(246, 234, 217, .15); box-shadow: 0 18px 40px -18px rgba(0, 0, 0, .6); }
  .menu-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; padding: 1.5rem 1rem 1.75rem; }
  .menu-grid div { display: grid; gap: .15rem; align-content: start; }
  .menu-title { margin: 0 0 .35rem; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .6; }
  .menu a { color: var(--cream); text-decoration: none; padding: .45rem 0; font-size: 1.05rem; border-bottom: 1px solid rgba(246, 234, 217, .08); }
  .menu a:hover { color: var(--warm); }
  .menu a.cat::before { content: ''; display: inline-block; width: .55rem; height: .55rem; margin-right: .55rem; border-radius: 50%; background: var(--cat); }
  @media (max-width: 900px) { .wide { display: none; } }
  @media (max-width: 700px) { .menu-grid { grid-template-columns: 1fr; gap: 1rem; } }
  @media (max-width: 560px) { nav { gap: .5rem; font-size: .85rem; } .lang { padding: .1rem .45rem; } .menu-btn { padding: .4rem .75rem; } }
</style>
