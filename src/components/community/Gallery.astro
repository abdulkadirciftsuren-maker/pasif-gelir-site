---
import { type Lang } from '../../i18n/ui';
import { communityPages, ct } from '../../i18n/community';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = ct(lang);
---

<div class="gallery-page">
  <p class="lead">{c.galleryLead}</p>
  <p><a class="btn" href={communityPages.share[lang]}>📷 {c.shareCta}</a></p>
  <p id="gal-note" class="note" hidden></p>
  <div id="gal-grid" class="grid"></div>
  <p class="more-wrap"><button id="gal-more" class="btn ghost" type="button" hidden>{c.more}</button></p>
</div>

<dialog id="gal-dialog">
  <img id="gal-big" alt="" />
  <div class="info">
    <p id="gal-title" class="title"></p>
    <p id="gal-by" class="by"></p>
    <p id="gal-text" class="text"></p>
  </div>
  <form method="dialog"><button class="btn" type="submit">{c.close}</button></form>
</dialog>

<script define:vars={{ c }}>
  const grid = document.getElementById('gal-grid');
  const note = document.getElementById('gal-note');
  const moreBtn = document.getElementById('gal-more');
  const dialog = document.getElementById('gal-dialog');
  let page = 0;

  function open(item) {
    document.getElementById('gal-big').src = `/foto/${item.id}`;
    document.getElementById('gal-big').alt = item.title || item.name;
    document.getElementById('gal-title').textContent = item.title || '';
    document.getElementById('gal-by').textContent = `${c.by}: ${item.name}`;
    document.getElementById('gal-text').textContent = item.text || '';
    dialog.showModal();
  }

  function card(item) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'item';
    const img = document.createElement('img');
    img.src = `/foto/${item.id}`;
    img.alt = item.title || item.name;
    img.loading = 'lazy';
    const cap = document.createElement('span');
    cap.className = 'cap';
    cap.textContent = item.title ? `${item.title} · ${item.name}` : item.name;
    btn.append(img, cap);
    btn.addEventListener('click', () => open(item));
    return btn;
  }

  async function load() {
    try {
      const res = await fetch(`/api/galeri?sayfa=${page}`);
      if (res.status === 503) { note.textContent = c.soon; note.hidden = false; return; }
      const data = await res.json();
      if (page === 0 && data.items.length === 0) { note.textContent = c.empty; note.hidden = false; }
      data.items.forEach((item) => grid.append(card(item)));
      moreBtn.hidden = !data.more;
    } catch {
      note.textContent = c.soon;
      note.hidden = false;
    }
  }

  moreBtn.addEventListener('click', () => { page += 1; load(); });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  load();
</script>

<style>
  .lead { font-size: 1.15rem; color: var(--muted); }
  .note { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: .9rem; margin-top: 1.25rem; }
  .grid :global(.item) { display: grid; gap: .35rem; padding: 0; border: 0; background: none; cursor: pointer; text-align: left; font: inherit; color: var(--text); }
  .grid :global(.item img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); background: var(--accent-soft); }
  .grid :global(.cap) { font-size: .9rem; color: var(--muted); line-height: 1.35; }
  .more-wrap { text-align: center; margin-top: 1.5rem; }
  .btn.ghost { background: transparent; color: var(--accent); border: 2px solid var(--accent); }
  dialog { max-width: min(92vw, 56rem); border: 0; border-radius: var(--radius); padding: 1rem; background: var(--surface); color: var(--text); }
  dialog::backdrop { background: rgba(20, 12, 8, .75); }
  dialog img { display: block; max-width: 100%; max-height: 70vh; margin: 0 auto; border-radius: 10px; }
  .info p { margin: .4rem 0; }
  .title { font: 700 1.2rem var(--serif); }
  .by { color: var(--muted); }
  .text { white-space: pre-line; }
</style>
