---
import { SITE } from '../config';
import Logo from './Logo.astro';
import { languages, localePath, staticPages, t, type Lang } from '../i18n/ui';
import { communityPages } from '../i18n/community';
import { glossaryPages } from '../i18n/glossary';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
// Bu sayfanın diğer dillerdeki karşılığı yoksa o dilin ana sayfasına gider.
const others = (Object.keys(languages) as Lang[])
  .filter((l) => l !== lang)
  .map((l) => ({ lang: l, href: alternates[l] ?? staticPages.home[l] }));
const home = localePath(lang);
const cats = ['yontem', 'ekipman', 'temel'] as const;

// Menü kartlarındaki çizgi simgeler (24×24, stroke = currentColor)
const icons = {
  guides: 'M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5zM4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5M8 7h8M8 11h6',
  yontem: 'M5 6h14l-5 8h-4zM10 14v3M14 14v3M7 20h10M16 3c0 1 1 1 1 2',
  ekipman: 'M7 3h10l-1 5H8zM6 8h12v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zM12 3V1M10 13h4',
  temel: 'M12 3c4 0 7 4 7 9s-3 9-7 9-7-4-7-9 3-9 7-9zM12 4c-2 3-2 13 0 16',
  calc: 'M5 3h14v18H5zM8 7h8M8 12h2M12 12h2M16 12v5M8 16h2M12 16h2',
  quiz: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM15.5 8.5l-2 5-5 2 2-5z',
  glossary: 'M4 4h6a2 2 0 0 1 2 2v14a2 2 0 0 0-2-2H4zM20 4h-6a2 2 0 0 0-2 2v14a2 2 0 0 1 2-2h6z',
  photo: 'M4 7h3l2-3h6l2 3h3v13H4zM12 10a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z',
  share: 'M12 4v12M7 9l5-5 5 5M5 20h14',
  home: 'M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10',
  about: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 11v6M12 7.5v.5',
  store: 'M3 9l2-5h14l2 5M3 9h18v2a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0zM5 13v8h14v-8M10 21v-5h4v5',
  espresso: 'M4 8h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM16 9h2a2 2 0 0 1 0 4h-2M3 21h14M8 2v3M12 2v3',
  design: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9V16h7v-2.1A6 6 0 0 0 12 3z',
  supply: 'M6 7h12l-1 14H7zM9 7V5a3 3 0 0 1 6 0v2M10 12c1 2 3 2 4 0',
  menu: 'M5 3h14v18H5zM8 8h8M8 12h8M8 16h5',
};
type Item = { href: string; label: string; icon: keyof typeof icons; tone: string };
const topics: Item[] = [
  { href: home + '#rehberler', label: t(lang, 'nav.guides'), icon: 'guides', tone: 'peach' },
  { href: `${home}#topic-yontem`, label: t(lang, 'cat.yontem'), icon: 'yontem', tone: 'green' },
  { href: `${home}#topic-ekipman`, label: t(lang, 'cat.ekipman'), icon: 'ekipman', tone: 'blue' },
  { href: `${home}#topic-temel`, label: t(lang, 'cat.temel'), icon: 'temel', tone: 'gold' },
];
const tools: Item[] = [
  { href: staticPages.calculator[lang], label: t(lang, 'nav.tools'), icon: 'calc', tone: 'peach' },
  { href: staticPages.machineQuiz[lang], label: t(lang, 'nav.quiz'), icon: 'quiz', tone: 'lilac' },
  { href: glossaryPages[lang], label: t(lang, 'nav.glossary'), icon: 'glossary', tone: 'green' },
  { href: communityPages.gallery[lang], label: t(lang, 'nav.community'), icon: 'photo', tone: 'pink' },
  { href: communityPages.share[lang], label: t(lang, 'community.homeCta'), icon: 'share', tone: 'blue' },
];
const cafe: Item[] = [
  { href: (staticPages.cafeGuide as Record<string, string>)[lang], label: t(lang, 'nav.cafeGuide'), icon: 'store', tone: 'peach' },
  { href: (staticPages.cafeEspresso as Record<string, string>)[lang], label: t(lang, 'nav.cafeEspresso'), icon: 'espresso', tone: 'gold' },
  { href: (staticPages.cafeDesign as Record<string, string>)[lang], label: t(lang, 'nav.cafeDesign'), icon: 'design', tone: 'lilac' },
  { href: (staticPages.cafeSupply as Record<string, string>)[lang], label: t(lang, 'nav.cafeSupply'), icon: 'supply', tone: 'green' },
  { href: (staticPages.cafeMenu as Record<string, string>)[lang], label: t(lang, 'nav.cafeMenu'), icon: 'menu', tone: 'pink' },
  { href: (staticPages.cafeCalculator as Record<string, string>)[lang], label: t(lang, 'nav.cafeCalc'), icon: 'calc', tone: 'blue' },
];
const site: Item[] = [
  { href: home, label: t(lang, 'nav.home'), icon: 'home', tone: 'peach' },
  { href: staticPages.about[lang], label: t(lang, 'nav.about'), icon: 'about', tone: 'lilac' },
];
// Bir dilde karşılığı olmayan sayfalar (ör. kafe bölümü henüz Rusça değil) menüde gösterilmez.
const groups = [
  { title: t(lang, 'home.topics'), items: topics },
  { title: t(lang, 'menu.tools'), items: tools },
  { title: '☕ ' + t(lang, 'nav.cafeSection'), items: cafe, cafe: true },
  { title: 'Fincanla', items: site },
]
  .map((g) => ({ ...g, items: g.items.filter((it) => it.href) }))
  .filter((g) => g.items.length);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={home} aria-label={SITE.name}>
      <Logo lang={lang} />
    </a>
    <nav aria-label="Ana menü">
      <a href={home + '#rehberler'} class="wide">{t(lang, 'nav.guides')}</a>
      <a href={staticPages.calculator[lang]} class="wide">{t(lang, 'nav.tools')}</a>
      <a href={communityPages.gallery[lang]} class="wide">{t(lang, 'nav.community')}</a>
      <!-- Tek dil düğmesi: basınca bütün diller açılır -->
      <details class="lang-pick" id="lang-pick">
        <summary aria-label={t(lang, 'menu.language')} translate="no">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" /></svg>
          {lang.toUpperCase()}
        </summary>
        <div class="lang-list">
          <span class="lang-item current" lang={lang} aria-current="true" translate="no">{languages[lang]}</span>
          {others.map((o) => (
            <a class="lang-item" href={o.href} hreflang={o.lang} lang={o.lang} translate="no">{languages[o.lang]}</a>
          ))}
        </div>
      </details>
      <button id="menu-btn" class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="bars" aria-hidden="true"></span><span class="mb-label">{t(lang, 'nav.menu')}</span>
      </button>
    </nav>
  </div>

  <!-- Açılır menü: simgeli kartlar; telefonda tek sütun, bilgisayarda yan yana -->
  <div id="site-menu" class="menu" hidden>
    <div class="container menu-inner">
      {groups.map((g) => (
        <section class={g.cafe ? 'group cafe' : 'group'}>
          <p class="menu-title">{g.title}</p>
          <div class="tiles">
            {g.items.map((it) => (
              <a class={`tile tone-${it.tone}`} href={it.href}>
                <span class="ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons[it.icon]} /></svg>
                </span>
                <span class="tl">{it.label}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
      <section class="group">
        <p class="menu-title">{t(lang, 'menu.language')}</p>
        <div class="langs">
          {(Object.keys(languages) as Lang[]).map((l) => (
            l === lang
              ? <span class="pill current" lang={l} aria-current="true" translate="no">{languages[l]}</span>
              : <a class="pill" href={alternates[l] ?? staticPages.home[l]} hreflang={l} lang={l} translate="no">{languages[l]}</a>
          ))}
        </div>
      </section>
    </div>
  </div>
</header>

<script define:vars={{ openLabel: t(lang, 'nav.menu'), closeLabel: t(lang, 'nav.close') }}>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('site-menu');
  function setOpen(open) {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? closeLabel : openLabel);
    btn.classList.toggle('open', open);
  }
  const pick = document.getElementById('lang-pick');
  btn.addEventListener('click', () => { pick.open = false; setOpen(menu.hidden); });
  pick.addEventListener('toggle', () => { if (pick.open) setOpen(false); });
  document.addEventListener('click', (e) => { if (pick.open && !pick.contains(e.target)) pick.open = false; });
  // Menüdeki bir bağlantıya basınca (ör. aynı sayfadaki bir konuya) menü kapansın
  menu.addEventListener('click', (e) => { if (e.target.closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
  document.addEventListener('click', (e) => { if (!menu.hidden && !menu.contains(e.target) && !btn.contains(e.target)) setOpen(false); });
</script>

<style>
  .site-header { position: relative; z-index: 20; background: var(--espresso); color: var(--cream); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.5rem; }
  .logo { display: flex; align-items: center; color: var(--cream); text-decoration: none; }
  nav { display: flex; align-items: center; gap: 1.1rem; font-size: .95rem; }
  nav a { color: var(--cream); text-decoration: none; white-space: nowrap; opacity: .9; }
  nav a:hover { color: var(--warm); opacity: 1; }
  .lang-pick { position: relative; }
  .lang-pick summary { list-style: none; display: inline-flex; align-items: center; gap: .35rem; cursor: pointer; border: 1px solid rgba(246, 234, 217, .35); border-radius: 999px; padding: .35rem .7rem; font-size: .85rem; font-weight: 700; color: var(--cream); user-select: none; }
  .lang-pick summary::-webkit-details-marker { display: none; }
  .lang-pick summary:hover, .lang-pick[open] summary { border-color: var(--warm); color: var(--warm); }
  .lang-list { position: absolute; right: 0; top: calc(100% + .5rem); z-index: 30; display: grid; min-width: 10rem; padding: .4rem; border-radius: 14px; background: var(--espresso-2); box-shadow: 0 14px 30px -12px rgba(0, 0, 0, .6); border: 1px solid rgba(246, 234, 217, .15); }
  .lang-item { padding: .6rem .8rem; border-radius: 10px; color: var(--cream); text-decoration: none; font-weight: 600; opacity: 1; }
  a.lang-item:hover { background: rgba(246, 234, 217, .1); color: var(--warm); }
  .lang-item.current { color: var(--warm); }
  .lang-item.current::after { content: ' ✓'; }
  /* Dar telefonlarda menü düğmesinde yalnız simge kalır (üst çubuk ekrana sığsın) */
  @media (max-width: 430px) { .mb-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .menu-btn { width: 2.6rem; height: 2.6rem; padding: 0; justify-content: center; } .lang-pick summary { padding: .35rem .6rem; } }
  .menu-btn { display: inline-flex; align-items: center; gap: .5rem; border: 0; border-radius: 999px; padding: .45rem .9rem; background: var(--warm); color: var(--espresso); font: inherit; font-weight: 700; cursor: pointer; }
  .menu-btn:hover { filter: brightness(1.08); }
  /* Üç çizgili simge; menü açılınca X olur */
  .bars, .bars::before, .bars::after { display: block; width: 1rem; height: 2px; background: currentColor; border-radius: 2px; transition: transform .2s, opacity .2s; }
  .bars { position: relative; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -5px; }
  .bars::after { top: 5px; }
  .menu-btn.open .bars { background: transparent; }
  .menu-btn.open .bars::before { transform: translateY(5px) rotate(45deg); }
  .menu-btn.open .bars::after { transform: translateY(-5px) rotate(-45deg); }
  .menu { position: absolute; left: 0; right: 0; top: 100%; max-height: calc(100vh - 4.5rem); overflow-y: auto; background: var(--espresso-2); border-top: 1px solid rgba(246, 234, 217, .15); box-shadow: 0 18px 40px -18px rgba(0, 0, 0, .6); }
  .menu-inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 2rem; padding: 1.25rem 1rem 1.5rem; }
  .menu-title { margin: 0 0 .5rem; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .65; }
  .cafe .menu-title { color: var(--warm); opacity: 1; }
  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
  .tile { display: flex; align-items: center; gap: .65rem; min-height: 3.4rem; padding: .5rem .65rem; border-radius: 14px; background: rgba(246, 234, 217, .06); color: var(--cream); text-decoration: none; line-height: 1.25; font-size: .95rem; font-weight: 600; transition: background .15s, transform .15s; }
  .tile:hover { background: rgba(246, 234, 217, .12); transform: translateY(-1px); }
  .ic { flex: none; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 12px; background: var(--tone-bg); color: var(--tone-fg); }
  .tone-peach { --tone-bg: #f7d3bd; --tone-fg: #8a3d1c; }
  .tone-green { --tone-bg: #cfe8d6; --tone-fg: #2d6142; }
  .tone-blue { --tone-bg: #cfe2f2; --tone-fg: #2c5a80; }
  .tone-gold { --tone-bg: #f4e2b0; --tone-fg: #7a5a12; }
  .tone-lilac { --tone-bg: #e2d8f3; --tone-fg: #5a3f8c; }
  .tone-pink { --tone-bg: #f5d3df; --tone-fg: #8c3556; }
  .langs { display: flex; flex-wrap: wrap; gap: .5rem; }
  .pill { padding: .5rem 1rem; border-radius: 999px; background: rgba(246, 234, 217, .06); color: var(--cream); text-decoration: none; font-weight: 600; border: 2px solid transparent; }
  a.pill:hover { background: rgba(246, 234, 217, .12); }
  .pill.current { border-color: var(--warm); }
  @media (max-width: 900px) { .wide { display: none; } }
  @media (max-width: 760px) { .menu-inner { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { nav { gap: .5rem; font-size: .85rem; } .menu-btn { padding: .4rem .75rem; } }
</style>
