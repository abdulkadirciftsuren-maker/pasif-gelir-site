    <h1>{L.title}</h1>
    <p class="muted lead">{L.desc}</p>

    <form class="quiz" id="machine-quiz" onsubmit="return false">
      {L.questions.map((item, qi) => (
        <fieldset>
          <legend><span class="num">{qi + 1}</span>{item.q}</legend>
          <div class="opts">
            {item.a.map((label, ai) => (
              <label class="opt"><input type="radio" name={`q${qi}`} value={ai} /><span>{label}</span></label>
            ))}
          </div>
        </fieldset>
      ))}
      <p class="missing" id="quiz-missing" hidden>{L.missing}</p>
      <button class="btn submit" type="submit" id="quiz-submit">{L.submit} →</button>
    </form>

    <section class="results" id="quiz-results" hidden aria-live="polite">
      {order.map((id) => {
        const r = L.results[id];
        return (
          <article class="result" data-type={id} hidden>
            <p class="kicker">{L.resultTitle}</p>
            <h2>{r.name}</h2>
            <p>{r.desc}</p>
            <ul class="picks">
              {r.products.map((p) => (
                <li>
                  <strong>{p.name}</strong>
                  <span class="btns">
                    <a class="btn" href={affiliateUrl(p.store, p.url)} rel="sponsored nofollow noopener" target="_blank">{cta(p.store)} →</a>
                    {lang === 'tr' && <a class="btn de" href={amazonDeSearchUrl(p.name)} rel="sponsored nofollow noopener" target="_blank">{L.ctaDe}</a>}
                  </span>
                </li>
              ))}
            </ul>
            <p><strong>{L.guidePrefix}</strong> <a href={r.guide}>{r.guideLabel}</a></p>
          </article>
        );
      })}
      <p class="second" id="quiz-second">{L.second} {order.map((id) => <a href={L.results[id].guide} data-type={id} hidden>{L.results[id].name}</a>)}</p>
      <button class="btn ghost" type="button" id="quiz-retry">↺ {L.retry}</button>
    </section>

    <p class="muted small">{L.note}</p>
    <slot />
  </div>
</BaseLayout>

<script define:vars={{ scores, order }}>
  const form = document.getElementById('machine-quiz');
  const results = document.getElementById('quiz-results');
  const missing = document.getElementById('quiz-missing');

  form.addEventListener('submit', () => {
    const totals = order.map(() => 0);
    for (let q = 0; q < scores.length; q++) {
      const picked = form.querySelector(`input[name="q${q}"]:checked`);
      if (!picked) {
        missing.hidden = false;
        form.querySelectorAll('fieldset')[q].scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      scores[q][Number(picked.value)].forEach((s, i) => { totals[i] += s; });
    }
    missing.hidden = true;
    // Türk kahvesi makinesi sadece Türk kahvesi içenlere önerilir.
    if (form.querySelector('input[name="q0"]:checked').value !== '3') totals[order.indexOf('turkish')] = -99;
    const ranked = order.map((id, i) => ({ id, s: totals[i] })).sort((a, b) => b.s - a.s);
    results.querySelectorAll('[data-type]').forEach((el) => {
      el.hidden = el.matches('.result') ? el.dataset.type !== ranked[0].id : el.dataset.type !== ranked[1].id;
    });
    results.hidden = false;
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('quiz-retry').addEventListener('click', () => {
    form.reset();
    results.hidden = true;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .wrap { padding-top: 3rem; }
  .lead { font-size: 1.15rem; }
  .small { font-size: .9rem; }
  .quiz { display: grid; gap: 1rem; margin: 1.5rem 0 1rem; }
  fieldset { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 1rem 1.1rem 1.1rem; margin: 0; }
  legend { font-weight: 700; padding: 0 .3rem; display: flex; align-items: center; gap: .5rem; }
  .num { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--accent); color: #fff; font-size: .85rem; }
  .opts { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: .5rem; margin-top: .4rem; }
  .opt { display: flex; align-items: center; gap: .55rem; padding: .65rem .75rem; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); cursor: pointer; line-height: 1.35; }
  .opt:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .opt input { accent-color: var(--accent); width: 1.1rem; height: 1.1rem; flex: none; }
  .submit { justify-self: start; font-size: 1.05rem; }
  .missing { color: var(--bad); font-weight: 600; margin: 0; }
  .results { margin: 1.5rem 0; padding: 1.25rem; border-radius: var(--radius); background: var(--accent-soft); border: 2px solid var(--accent); scroll-margin-top: 5rem; }
  .kicker { margin: 0; font-size: .85rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; }
  .result h2 { margin: .2rem 0 .5rem; }
  .picks { list-style: none; padding: 0; display: grid; gap: .6rem; margin: 1rem 0; }
  .picks li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; background: var(--surface); border-radius: 12px; padding: .75rem .9rem; }
  .btns { display: flex; flex-wrap: wrap; gap: .4rem; }
  .btn.de { background: var(--surface); color: var(--text); border: 1px solid var(--border); }
  .btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .second { margin: .5rem 0 1rem; }
  .second a:not([hidden]) { font-weight: 700; }
  @media (max-width: 520px) { .opts { grid-template-columns: 1fr; } }
</style>
